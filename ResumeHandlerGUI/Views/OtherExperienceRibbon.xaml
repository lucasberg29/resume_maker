<UserControl x:Class="ResumeHandlerGUI.Views.OtherExperienceRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ResumeHandlerGUI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="1024">
    <Border Background="{StaticResource Resume.MenuSelectedBackgroundColourBrush}"
        CornerRadius="0,0,15,15" Margin="20,0,20,20">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="10" Grid.Column="0">
                <TextBlock x:Name="OtherExperienceTitle" Text="Other experience:" Margin="0,10,0,4"/>
                <ListBox x:Name="OtherExperienceListBox" 
                         Width="200" 
                         SelectionMode="Multiple"
                         SelectionChanged="OtherExperienceListBox_SelectionChanged">
                    <ListBoxItem>
                        Hello
                    </ListBoxItem>
                </ListBox>
                <Button x:Name="AddExperienceButton" 
                        Click="AddExperienceButton_Click" 
                        Margin="10,10,10,10" 
                        Content="Add Experience"></Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
