

<Window x:Class="ResumeHandlerGUI.AddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Address Editor"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="15">

        <TextBlock x:Name="CurrentAddressTitle" Text="Current Address:" Margin="0,10,0,4"/>
        <TextBlock x:Name="CurrentAddress" Text="" Margin="0,0,0,4"/>

        <TextBlock x:Name="NewAddressTitle" Text="New Address:" Margin="0,0,0,4"/>
        <TextBox x:Name="NewAddressInputField" Width="220"/>

        <StackPanel x:Name="ButtonsPanel"
            Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Cancel"
                    Width="70"
                    Margin="5,5,0,0"
                    Click="Cancel_Click"></Button>
            <Button x:Name="UpdateButton" Content="Update"
        Width="70"
        Margin="5,5,0,0"
        Click="Update_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
