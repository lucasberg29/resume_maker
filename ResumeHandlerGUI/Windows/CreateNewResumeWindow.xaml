<Window x:Class="ResumeHandlerGUI.Windows.CreateNewResumeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResumeHandlerGUI.Windows"
        mc:Ignorable="d"
        Title="Create New Resume" Height="200" Width="400">
    <StackPanel Margin="15">

        <TextBlock x:Name="NewResumeName" Text="New Resume Name:" Margin="0,10,0,4"/>

        <TextBox x:Name="NewResumeNameInputField" MinWidth="200"/>

        <StackPanel x:Name="ButtonsPanel"
            Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Cancel"
                    Width="70"
                    Margin="5,5,0,0"
                    Click="CancelButton_Click"></Button>
            <Button x:Name="CreateResume" Content="Create Resume"
                    Width="100"
                    Margin="5,5,0,0"
                    Click="CreateResumeButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
