<Window x:Class="ResumeHandlerGUI.Windows.EditParagraphStylingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResumeHandlerGUI.Windows"
        mc:Ignorable="d"
        Title="Edit Paragraph Styling"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">
        <TextBlock x:Name="MarginTitle" Text="Margin:" Margin="0,10,0,4"/>
        <Grid HorizontalAlignment="Center" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="LeftMargin" Text="Left:" Margin="3,3,3,3" />
                <TextBox  x:Name="LeftMarginTextBox" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="TopMargin" Text="Top:" Margin="3,3,3,3" />
                <TextBox  x:Name="TopMarginTextBox" Text="0"  />
            </StackPanel>
            <StackPanel Grid.Column="2" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="RightMargin" Text="Right:" Margin="3,3,3,3" />
                <TextBox  x:Name="RightMarginTextBox" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="3" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="BottomMargin" Text="Bottom:"  Margin="3,3,3,3"/>
                <TextBox  x:Name="BottomMarginTextBox" Text="0" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PaddingTitle" Text="Padding:" Margin="0,10,0,4"/>
        <Grid HorizontalAlignment="Center" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="LeftPadding" Text="Left:" Margin="3,3,3,3" />
                <TextBox  x:Name="LeftPaddingTextBox" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="TopPadding" Text="Top:" Margin="3,3,3,3" />
                <TextBox  x:Name="TopPaddingTextBox" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="2" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="RightPadding" Text="Right:" Margin="3,3,3,3" />
                <TextBox  x:Name="RightPaddingTextBox" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="3" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="BottomPadding" Text="Bottom:"  Margin="3,3,3,3"/>
                <TextBox  x:Name="BottomPaddingTextBox" Text="0" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="FileTextTitle" Text="Text alignment:" />

        <StackPanel  Orientation="Horizontal" Margin="10,14,10,0">
            <RadioButton x:Name="AlignLeft"
                 Content="Left"
                 GroupName="TextAlignment"
                 Margin="0,0,12,0"
                 IsChecked="True"/>
            <RadioButton x:Name="AlignCenter"
                 Content="Center"
                 GroupName="TextAlignment"
                 Margin="0,0,12,0"/>
            <RadioButton x:Name="AlignRight"
                 Content="Right"
                 GroupName="TextAlignment"
                 Margin="0,0,12,0"/>
            <RadioButton x:Name="AlignJustify"
                 Content="Justify"
                 GroupName="TextAlignment"/>
        </StackPanel>
        <TextBlock x:Name="SpacingTitle" Text="Spacing:" Margin="0,10,0,4"/>
        <Grid HorizontalAlignment="Center" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="LineSpacingTitle" Text="Line:" Margin="3,3,3,3" />
                <TextBox  x:Name="LineSpacing" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="BeforeTitle" Text="Before:" Margin="3,3,3,3" />
                <TextBox  x:Name="Before" Text="0" />
            </StackPanel>
            <StackPanel Grid.Column="2" MinWidth="40" Margin="0,0,10,10">
                <TextBlock  x:Name="AfterTitle" Text="After:" Margin="3,3,3,3" />
                <TextBox  x:Name="After" Text="0" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ButtonsPanel"
            Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,15,0,0">
                <Button x:Name="CancelButton" Content="Cancel"
                    Width="40"
                    Margin="5,5,0,0"
                    Click="CancelButton_Click"></Button>
                <Button x:Name="UpdateLink" Content="Update"
                    Width="70"
                    Margin="5,5,0,0"
                    Click="UpdateParagraphStylingButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
