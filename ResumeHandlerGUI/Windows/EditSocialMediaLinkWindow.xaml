<Window x:Class="ResumeHandlerGUI.Windows.EditSocialMediaLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ResumeHandlerGUI"
        Title="Edit Social Media Link"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">

        <TextBlock x:Name="LinkSelectedTitle" Text="Item selected:" Margin="0,10,0,4"/>

        <TextBlock x:Name="LinkSelected" 
                   Text="Portfolio" 
                   Margin="10" 
                   TextAlignment="Center" 
                   HorizontalAlignment="Center" FontWeight="Bold" MinWidth="200"/>
        <TextBlock x:Name="FileTextTitle" Text="Current File:" />

        <TextBlock x:Name="FileText" Text="File.png" FontWeight="bold" TextAlignment="Center" Margin="10"/>
        <Button Content="Browse..."
                Width="80"
                HorizontalAlignment="Left"
                Click="BrowseFile_Click"/>
        <TextBox x:Name="BrowseFileTextBox" Width="220" Margin="0,10,0,4"/>

        <TextBlock Text="Hyperlink" Margin="0,0,0,4"/>
        <TextBox x:Name="HyperlinkTextBox" Width="220"/>

        <TextBlock Text="Name" Margin="0,0,0,4"/>
        <TextBox x:Name="NameTextBox" Width="220"/>

        <TextBlock Text="Alt" Margin="0,0,0,4"/>
        <TextBox x:Name="AltTextBox" Width="220"/>

        <StackPanel x:Name="ButtonsPanel"
            Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Cancel"
                    Width="40"
                    Margin="5,5,0,0"
                    Click="CancelButton_Click"></Button>
            <Button x:Name="DeleteButton" Content="Delete"
                    Width="40"
                    Margin="5,5,0,0"
                    Click="DeleteButton_Click"></Button>
            <Button x:Name="UpdateLink" Content="Update"
                    Width="70"
                    Margin="5,5,0,0"
                    Click="UpdateSocialMediaLinkButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
